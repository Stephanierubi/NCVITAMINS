@model CCustomization.CustomClasses.AutorizeClass
@{
    ViewBag.Title = "Iniciar sesión";
}
<link href="~/Content/login.css" rel="stylesheet" />

<div class="row">
    <div class="col-xs-12 col-md-6 col-md-offset-3">
        <div class="card card-container text-center" id="login-form">

            @*<h2 class="text-center customNess">Mngt store</h2>*@
            <section id="loginForm">
                @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                {

                    <hr />
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="form-group">
                        @Html.LabelForModel("Usuario", new { @class = "w-50" })
                        <div class="w-50 m-auto">
                            @Html.TextBoxFor(m => m.userName, new { @class = "form-control m-auto" })
                            @Html.ValidationMessageFor(m => m.userName, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelForModel("Contraseña", new { @class = "w-50" })
                        <div class="w-50 m-auto">
                            @Html.PasswordFor(m => m.password, new { @class = "form-control m-auto" })
                            @Html.ValidationMessageFor(m => m.password, "", new { @class = "text-danger" })
                        </div>
                    </div>                   
                    <div class="form-group">
                        <div class="w-50 m-auto">
                            <input type="submit" value="Iniciar sesión" class="btn btn-green btn-block" />
                        </div>
                    </div>

                    @* Habilite esta opción después de habilitar la confirmación de la cuenta para la función de restablecimiento de contraseña
                        <p>
                            @Html.ActionLink("¿Ha olvidado su contraseña?", "ForgotPassword")
                        </p>*@
                }
            </section>
        </div>
    </div>


</div>

@section Scripts {
    @*@Scripts.Render("~/bundles/jqueryval");*@

    <script>
        $(document).ready(function () {

            $.ajax({
                dataType: "json",
                url: "/CatalogDetails/GetDataCatalogJson?catalogName=Tienda",
                success: function (response) {
                    JsonData = response;
                    $("select#Tienda").append('<option value=""></option>');
                    JsonData.forEach(function (item) {
                        $("select#Tienda").append('<option value="' + item.Id + '">' + item.Name + '</option>');
                    });
                }
            });
        });

        function SetTiendaToLocaStorage() {
            var TiendaVal = $("select#Tienda").val();
            localStorage.setItem('LSTienda', TiendaVal);
        }
    </script>
}