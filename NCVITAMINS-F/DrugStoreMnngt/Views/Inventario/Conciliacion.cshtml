@model DrugStoreMnngt.Models.InventarioCustom@using (Html.BeginForm("conciliacion", "Inventario", FormMethod.Post, new { onsubmit = "return validationonsubmit();" })){@Html.HiddenFor(f => f.Id, new { Id = "HdId", Value = Model.Id });<div class="container">    <div class="row">        <br>        @if (Model.Cerrado == null)        {<div class="col-md-3">    <div class="form-group">        @Html.Label("Almacén")        <br />        @Html.DropDownList("Almancen", Enumerable.Empty<SelectListItem>(), new { @class = "form-control  input-sm", @OnChange = "ChangeAlmacen();", @required = "required" })    </div></div>}        <div class="col-md-12">            <div class="form-horizontal">                @if (Model.Cerrado == null)                {<table class="direction table table-bordered">    <thead>    </thead>    <tbody>        <tr id="trToInsert">            <td>                <div class="col-lg-4">                    <div class="form-group" style="margin-bottom: 0px;">                        @Html.DropDownList("ProductoID", Enumerable.Empty<SelectListItem>(), new { @class = "form-control", @onchange = "Get_dataItem()" })                    </div>                </div>            </td>            <td>                <div class="col-lg-8">                    <div class="form-group" style="margin-bottom: 0px;">                        @Html.TextBox("quantity", " ", new { @id = "quantity", @placeholder = "Digite la cantidad", @class = "form-control  input-sm", @readonly = "readonly" })                    </div>                </div>            </td>            <td>                <button id="btnAddItem" type="button" class="btn btn-primary btn-sm" onclick="AddItem(this)">                    <span class="glyphicon glyphicon-plus"></span> Agregar                </button>            </td>        </tr>    </tbody></table>}                <table id="table-items" class="direction table table-bordered table-condensed">                    <thead>                        <tr>                            <th>                                @Html.DisplayName("Almacen")                            </th>                            <th>                                @Html.DisplayName("Código")                            </th>                            <th>                                @Html.DisplayName("Producto")                            </th>                            <th>                                @Html.DisplayName("Existencia")                            </th>                            <th>                                @Html.DisplayName("Cantidad")                            </th>                            <th>                                @Html.DisplayName("Diferencia")                            </th>                    </thead>                    <tbody>                        @if (Model.productos?.Count > 0)                        {                            foreach (var item in Model.productos)                            {        <tr>            <td id='detItemId'>                <input hidden rawname='Id' readonly value=@item.Id />                <input hidden rawname='ProductoId' readonly value=@item.ProductoId />                <input hidden productoid=@item.ProductoId rawname='AlmacenId' readonly value=@item.AlmacenId />                @item.NombreAlmacen            </td>            <td id='detItemId'>@item.CodigoProducto</td>            <td id='detProduct'>@item.NombreProducto</td>            <td id='detQuantity'>                @if (Model.Cerrado != null && Model.Cerrado == true)                {@item.ExistenciaEnSistema }                        else                        { <input rawname='ExistenciaEnSistema' class="form-control  input-sm" style="text-align:right" readonly value="@item.ExistenciaEnSistema" />}            </td>            <td id='detQuantity'>                @if (Model.Cerrado != null && Model.Cerrado == true)                {@item.CantidadFisica }                        else                        { <input rawname='CantidadFisica' @(Model.Cerrado == null ? "" : "readonly") class="form-control  input-sm" style="text-align:right" onkeyup="CalculateDiferencia(this)" value="@item.CantidadFisica" />}            </td>            <td id='detQuantity'>                @if (Model.Cerrado != null && Model.Cerrado == true)                {@(item.CantidadFisica - item.ExistenciaEnSistema) }                        else                        { <input rawname='Diferencia' class="form-control  input-sm" style="text-align:right" readonly value="@(item.CantidadFisica - item.ExistenciaEnSistema)" />}            </td>            @*<td id='detRemove'><a href='#' onclick="$(this).closest('tr').remove();FixNameDetail();"><i style='color:red;vertical-align:middle' class="glyphicon glyphicon-remove"></i></a></td>*@        </tr>}}                    </tbody>                </table>                @if (Model.Cerrado == null)                {<div class="col-md-3">                        <br />                        <button id="btnInsert" name="btnInsert" type="submit" class="btn btn-success btn-sm">                            <i class="glyphicon glyphicon-floppy-disk"></i> Guardar                        </button>                    </div>}                <br>            </div>        </div>    </div></div>}<br><div>    <a href="Index" class="btn btn-danger btn-xs"><span class="glyphicon glyphicon-chevron-left"></span> Regresar</a></div>@{ var exceldd = "";    var Blfrtip = "";    if (Model.Cerrado != null && Model.Cerrado == true)    {        Blfrtip = "Blfrtip";        exceldd = "excel";    }}@section scripts{    <script>        $(document).ready(function () {            showLoadingProcess(true, 'Cargando...');            $.ajax({                dataType: "json",                url: "GetAlmacenJson",                success: function (response) {                    showLoadingProcess(false);                    AlmacenJson = response;                    $("select#Almancen").append('<option value=""></option>');                    AlmacenJson.almacenes.forEach(function (item) {                        $("select#Almancen").append(`<option value="${item.Id}" title="${item.Description}">${item.Name}</option>`);                    });                    $("select#ProductoID").chosen({ allow_single_deselect: true, width: '300px' });                    $("input#quantity").val(null);                }            });            var table = $('#table-items').DataTable({                lengthMenu: [[-1], ["Todos"]],                fixedHeader: false,                dom: '@Blfrtip',                iDisplayLength: -1,                buttons:['@exceldd']            });            $("select#ProductoID").attr('data-placeholder', "Seleccione un producto");            $("select#ProductoID").removeAttr('name');            FixNameDetail();        });        function ChangeAlmacen() {            showLoadingProcess(true, 'Cargando...');            var concilacioId = $("#HdId").val();            var almacenId = $("select#Almancen").val();            console.log(almacenId);            console.log(concilacioId);            var productoArray = $('input[rawname="AlmacenId"][value="' + almacenId + '"]').map(function (i, m) { return parseInt($(m).attr('productoid')) }).toArray()            $.ajax({                dataType: "json",                url: `GetProductosJson?almacenId=${almacenId}&conciliacionId=${concilacioId}`,                success: function (response) {                    showLoadingProcess(false);                    JsonData = response;                    JsonData.productos = JsonData.productos.filter(f => productoArray.indexOf(f.ProductoId) == -1);                    console.log(concilacioId);                    $("select#ProductoID").find('option').remove();                    $("select#ProductoID").append('<option value=""></option>');                    JsonData.productos.forEach(function (item) {                        console.log(item);                        $("select#ProductoID").append(`<option value="${item.ProductoId}">${item.CodigoProducto} - ${item.NombreProducto}</option>`);                    });                    $("select#ProductoID").val('').trigger("chosen:updated");                }            });            $("select#ProductoID").attr('data-placeholder', "Seleccione un producto");            $("select#ProductoID").removeAttr('name');        }        function Get_dataItem() {            var productoId = $("select#ProductoID").val();            var selectedProduct = JsonData.productos.find(f => f.ProductoId == productoId);            console.log(selectedProduct);            $("input#item_Id").val(selectedProduct.CodigoProducto);            $("input#price").val(selectedProduct.PrecioVenta);            //$("input#Precio").attr('readonly', 'readonly');            $("input#quantity").val(null);            $("input#quantity").removeAttr('readonly');        }        function AddItem(sender) {            var $sender = $(sender);            var $row = $sender.closest('tr');            var productoId = $("select#ProductoID").val();            var selectedProduct = JsonData.productos.find(f => f.ProductoId == productoId);            var productName = selectedProduct.NombreProducto;            var itemId = selectedProduct.CodigoProducto;            var quantity = $row.find("input#quantity").val();            var fl = parseFloat(quantity)            if (isNaN(fl) || fl < 0) {                toastr.warning(`Ingrese un valor númerico mayor o igual a 0`);                return;            }            var table = $('#table-items');            var datatable = table.DataTable();            datatable.row.add(                [                    `                                <input hidden rawname='Id' readonly value=0 />                                <input hidden rawname='ProductoId' readonly value =${selectedProduct.ProductoId} />                                <input hidden productoid=${selectedProduct.ProductoId} rawname='AlmacenId' readonly value =${selectedProduct.AlmacenId} />                                ${selectedProduct.NombreAlmacen}`,                    `${itemId}`,                    `${productName}`,                    `<input rawname='ExistenciaEnSistema' class="form-control  input-sm"  style="text-align:right" readonly value=${selectedProduct.ExistenciaEnSistema} />`,                    `<input rawname='CantidadFisica' class="form-control  input-sm"  style="text-align:right" onkeyup="CalculateDiferencia(this)" value=${quantity} />`,                    `<input rawname='Diferencia' class="form-control  input-sm"  style="text-align:right" readonly value=${quantity - selectedProduct.ExistenciaEnSistema} />`                ]            ).draw();            //$('#table-items tbody')            //    .append(            //        `<tr>            //                                                <td hidden='hidden' id='detId'><input rawname='Id' readonly value=0/></td>            //                                                <td hidden='hidden' id='detProductId'><input rawname='ProductoId' readonly value =${selectedProduct.ProductoId} /></td>            //                                                <td hidden='hidden' id='AlmacenId'><input  productoid=${selectedProduct.ProductoId} rawname='AlmacenId' readonly value =${selectedProduct.AlmacenId} /></td>            //                                                <td id='detItemId'><input rawname='Almacen' class="form-control  input-sm" readonly value=${selectedProduct.NombreAlmacen} /></td>            //                                                <td id='detItemId'><input rawname='Codigo' class="form-control  input-sm" readonly value=${itemId} /></td>            //                                                <td id='detProduct'><input  class="form-control  input-sm" readonly value=${productName} /></td>            //                                                <td id='detQuantity'><input rawname='ExistenciaEnSistema' class="form-control  input-sm"  style="text-align:right" readonly value=${selectedProduct.ExistenciaEnSistema} /></td>            //                                                <td id='detQuantity'><input rawname='CantidadFisica' class="form-control  input-sm"  style="text-align:right" onkeyup="CalculateDiferencia(this)" value=${quantity} /></td>            //                                                <td id='detQuantity'><input rawname='Diferencia' class="form-control  input-sm"  style="text-align:right" readonly value=${quantity - selectedProduct.ExistenciaEnSistema} /></td>            //                                             </tr>`);            //<td id='detRemove'><a href='#' onclick="$(this).closest('tr').remove();FixNameDetail();"><i style='color:red;vertical-align:middle' class="glyphicon glyphicon-remove"></i></a></td>            FixNameDetail();            $("select#ProductoID option:selected").remove();            $("select#ProductoID").trigger('chosen:updated');            $("select#ProductoID").trigger('chosen:activate');            ClearRow();        }        function CalculateDiferencia($sender) {            $sender = $($sender);            var cant = $sender.val();            var exist = $sender.closest('tr').find('input[rawname="ExistenciaEnSistema"]').val();            $sender.closest('tr').find('input[rawname="Diferencia"]').val(cant - exist);        }        function ClearRow() {            var $row = $("#trToInsert");            $row.find('input#item_Id').val(null);            $row.find("input#price").val(null);            $row.find("input#quantity").val(null);            $('select#ProductoID').val('').trigger('chosen:updated');        }        function FixNameDetail() {            $('#table-items tbody td input[rawname]').each(function (index, item) {                item = $(item);                var index = $(item).closest('tr').index();                var rawname = item.attr('rawname');                item.attr('name', `productos[${index}].${rawname}`);            });        }        $("input#quantity").on("keydown", function (e) {            console.log("keydown");            var keyCode = (e.keyCode ? e.keyCode : e.which);            if (keyCode == 13) {                e.preventDefault();                AddItem($("#btnAddItem")[0]);            }        });        function validationonsubmit() {            var table = $('#table-items').DataTable();            table.search('').draw();            var rowcounts = table.rows().count();            if (rowcounts == 0) {                toastr.warning("Registre una fila para guardar la compra");                return false;            };            $('#Almancen').removeAttr('required');            return true;        }    </script>}