@model IEnumerable<DrugStoreMnngt.Models.BD.vw_DatosEmpleados>

@{
    ViewBag.Title = "Index";
}


<p>
    
    <a href="@Url.Action("Create","Empleados")" class="btn btn-primary btn-xs"><span class="glyphicon glyphicon-plus"></span> Agregar Empleado</a>
</p>
<table id="tblEmplados" class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombres)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Apellidos)
            </th>
            <th>
                Direccion
            </th>
            <th>
                Telefono
            </th>
            <th></th>
        </tr>
</thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Nombres)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Apellidos)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DireccionPrincipal)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TelefonoPrincipal)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-sm btn-info" }) 
                    @Html.ActionLink("Agregar Usuario", "AgregarEmpleadoUsuario", new { id = item.ID }, new { @class = "btn btn-sm btn-default" })
                </td>
            </tr>
        }
    </tbody>
</table>
@section scripts
    {

    <script>
        $(document).ready(function () {

            var table = $('#tblEmplados').DataTable({
                lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
                fixedHeader: false,
                dom: 'Blfrtip',
                buttons: [
                    'excel'

                ]

            });
        });

    </script>
}