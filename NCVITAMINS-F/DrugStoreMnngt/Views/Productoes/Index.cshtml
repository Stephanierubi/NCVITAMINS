@model IEnumerable<DrugStoreMnngt.Models.ProductoCustom>
@using SecurityShell.Models;
@{
    ViewBag.Title = "Index";
}

@*<h2>Lista de Productos</h2>*@

<br>
@{
    if (InformationIdentity.TypeID() == 1)
    {
        <p>
            @Html.ActionLink("Crear nuevo producto", "Create")
        </p>
    }

    <div class="col-md-12">
        <div class="form-group">
            @Html.DropDownList("Estado", (IEnumerable<SelectListItem>)ViewBag.StatusList, new { @class = "form-control input-sm pull-right", @style = "margin:5px;", @Name = "", @required = "required", @onchange = "GetProductoByStatus();" })
        </div>
    </div>
}
<table id="tablelist" class=" table-striped display compact dt-body-center dt-head-center">
    <thead>
        <tr>
            <th>

            </th>
            <th>
                Código
            </th>
            <th>
                Descripción Específica
            </th>
            <th>
                Descripción General
            </th>
            <th>
                Marca
            </th>
            <th>
                Presentación
            </th>
            <th style="text-align:right">
                Precio
            </th>
            <th>
                Cod. Barra
            </th>

            <th style="text-align:right">
                Cant. Disponible
            </th>
            @{
                var almacenesList = Model.SelectMany(s => s.almacenes).Select(s => s.Almacen).Distinct().OrderBy(o => o).ToList();

            }
            @foreach (var item in almacenesList)
            {
                <th hidden>@item</th>
            }
            <th style="text-align:right">
                Cant. Presentación
            </th>
            <th style="text-align:center">
                Vencimiento
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var jsonAlmacen = Newtonsoft.Json.JsonConvert.SerializeObject(item.almacenes);
            var styleDeleted = item.Activo == false ? "background-color: #ff599085 !important" : "";

            <tr jsondetail="@jsonAlmacen" style='@styleDeleted'>
                <td class="details-control" style="cursor:pointer;color:#1111b3" title="Mostrar cantidad por almacén">
                    <span class="glyphicon glyphicon-plus"></span>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CodigoProducto)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DescripcionEspecifica)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DescripcionGeneral)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Marca)
                </td>
                <td>
                    @*@{string fec = string.Empty;
                            if (item.FechaVencimiento.HasValue)
                            {
                                fec = item.FechaVencimiento.Value.ToString("dd/MM/yy");
                            }
                        }*@
                    @Html.DisplayFor(modelItem => item.TipoPresentacion)
                </td>

                <td style="text-align:right">
                    @Html.DisplayFor(modelItem => item.PrecioVenta)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CodigoBarra)
                </td>
                <td style="text-align:right">
                    @Html.DisplayFor(modelItem => item.CantidadDisponible)
                </td>
                @foreach (var alm in almacenesList)
                {
                    var almacen = item.almacenes.FirstOrDefault(f => f.Almacen == alm);
                    var almacenCantidad = (almacen?.Cantidad) ?? 0;
                    <td style="text-align:right" hidden>
                        @Html.DisplayFor(modelItem => almacenCantidad)
                    </td>
                }
                <td style="text-align:right">
                    @Html.DisplayFor(modelItem => item.CantidadPrecentacion)
                </td>
                <td style="text-align:right">
                    @if (item.FechaVencimiento != null)
                    {
                        @item.FechaVencimiento.Value.ToString("dd/MM/yyyy")
                    }
                </td>
                <td>
                    @{ if (InformationIdentity.TypeID() == 1)
                        {
                            @Html.ActionLink("Editar", "Edit", new { id = item.ID }, new { @class = "btn btn-sm btn-info" })<br />
                            if (item.Activo == false)
                            {
                                @Html.ActionLink("Activar", "Active", new { id = item.ID }, new { @class = "btn btn-sm btn-success" })
                            }
                            else
                            {

                                @Html.ActionLink("Borrar", "Delete", new { id = item.ID }, new { @class = "btn btn-sm btn-danger" })
                            }
                            <br />
                            @Html.ActionLink("Historico", "HistoricoTransaccionesProducto", new { Producto = item.ID }, new { @class = "btn btn-sm btn-primary" })

                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
@section scripts
    {
    <script>

        $(document).ready(function () {

            var table = $('#tablelist').DataTable({
                lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
                fixedHeader: false,
                dom: 'Blfrtip',
                responsive: true,
                buttons: [
                     'excel'

                ]

            });
            console.log("Info usuario id " + @InformationIdentity.TypeID());
            function getButtonsString() {
                var info;
                if (@InformationIdentity.TypeID() !== 2) {
                    info = "'copy', 'excel', 'pdf'";
                }
                return info;
            }


            $('#tablelist').on('click', 'tr td.details-control', function () {
                var tr = $(this).closest('tr');
                var row = $('#tablelist').DataTable().row(tr);

                $(this).find('span').toggleClass("glyphicon-plus glyphicon-minus")

                if (row.child.isShown()) {
                    tr.removeClass('details');
                    row.child.hide();

                }
                else {
                    tr.addClass('details');
                    var jsonAlm = tr.attr('jsondetail');

                    var dataDet = JSON.parse(jsonAlm);
                    var htmlrow = '<thead><tr><th style="text-align:center">Almacén</th><th style="text-align:center">Cantidad</th></tr></thead><tbody>';
                    dataDet.forEach(function (item, index) {
                        htmlrow += `<tr><td style="text-align:center">${item.Almacen}</td><td style="text-align:center">${item.Cantidad}</td></tr>`;
                    });
                    htmlrow = `<table  style="width:50%;margin-left:20px; border: 1px black solid;">${htmlrow}</tbody></table>`

                    row.child(htmlrow).show();

                }
            });



        });


        function GetProductoByStatus() {

            var selectstatus = $("#Estado option:selected").val();
            window.location.href = "/Productoes/Index/?activos=" + selectstatus;
        }

    </script>

}