@model DrugStoreMnngt.Models.TrasladoCustomCustom@using (Html.BeginForm("TrasladoProducto","Productoes",FormMethod.Post, new { onsubmit = "return validationonsubmit();" })){<div class="container">    <div class="row">        <br>        <div class="col-md-12">            <div>                <div class="col-md-12">                    <div class="form-group col-md-3">                            @Html.Label("De:")                            @Html.DropDownList("AlmancenOrigen", Enumerable.Empty<SelectListItem>(), new { @onchange = "ChangeAlmacenOrigen()", @class = "form-control  input-sm", @required = "required" })                                           </div>                    <div class="form-group col-md-3">                            @Html.Label("Hacia:")                            @Html.DropDownList("AlmacenDestino", Enumerable.Empty<SelectListItem>(), new { @class = "form-control  input-sm", @required = "required" })                                       </div>                    <div class="form-group col-md-3">                        @Html.Label("Producto:")                            @Html.DropDownList("ProductoID", Enumerable.Empty<SelectListItem>(), new { @class = "form-control", @onchange = "Get_dataItem()" })                                          </div>                    <div class="form-group col-md-3">                        @Html.Label("Cantidad:")                            @Html.TextBox("quantity", " ", new { @id = "quantity", @placeholder = "Digite la cantidad", @class = "form-control  input-sm" })                                           </div>                    <div class="form-group col-md-12">                        @Html.Label("Comentario:")                            @Html.TextBox("comentario", " ", new { @id = "comentario", @placeholder = "Nota o comentario", @style = "max-width:100%;", @class = "form-control  input-sm col-md-12" })                                           </div>                </div>                <div class="col-md-12">                    <div class="form-group pull-right">                        <button id="btnAddItem" type="button" class="btn btn-primary btn-sm" onclick="AddItem(this)">                            <span class="glyphicon glyphicon-plus"></span> Agregar                        </button>                    </div>                </div>                <table id="table-items" class="direction table table-bordered table-condensed">                    <thead>                        <tr>                            <th>                                @Html.DisplayName("Codigo Barra")                            </th>                            <th>                                @Html.DisplayName("Producto")                            </th>                            <th>                                @Html.DisplayName("De")                            </th>                            <th>                                @Html.DisplayName("Hacia")                            </th>                            <th>                                @Html.DisplayName("Cantidad")                            </th>                            <th>                            </th>                    </thead>                    <tbody>                    </tbody>                </table>                <div class="col-md-3">                    <br />                    <button id="btnInsert" name="btnInsert" type="submit" class="btn btn-success btn-sm">                        <i class="glyphicon glyphicon-floppy-disk"></i> Guardar                    </button>                </div>                <br>            </div>        </div>    </div></div>}<br><div>    <a href="DetalleMovimientosTraslado" class="btn btn-danger btn-xs"><span class="glyphicon glyphicon-chevron-left"></span> Regresar</a></div>@section scripts{    <script>        $(document).ready(function () {            showLoadingProcess(true, 'Cargando');            $.ajax({                dataType: "json",                url: "GetAlmacenOrigenJson",                success: function (response) {                    showLoadingProcess(false);                    JsonData = response;                    $("select#AlmancenOrigen").append('<option value=""></option>');                    JsonData.almacenes.forEach(function (item) {                        $("select#AlmancenOrigen").append(`<option value="${item.Id}" title="${item.Description}">${item.Name}</option>`);                    });                    $("select#ProductoID").chosen({ allow_single_deselect: true });                    $("input#quantity").val(null);                    $("input#comentario").val(null);                }            });            $("select#ProductoID").attr('data-placeholder', "Seleccione un producto");            $("select#ProductoID").removeAttr('name');        });        function ChangeAlmacenOrigen() {            showLoadingProcess(true, 'Cargando');            var almacenorigen = $("select#AlmancenOrigen").val();            if (almacenorigen == "" || almacenorigen == null) return;            $.ajax({                dataType: "json",                url: "GetAlmacenProductoDisponible?AlmacenId=" + almacenorigen,                success: function (response) {                    showLoadingProcess(false);                    JsonData = response;                    $("select#ProductoID").append('<option value=""></option>');                    $("select#ProductoID").find('option').remove();                    JsonData.productos.forEach(function (item) {                        $("select#ProductoID").append(`<option value="${item.ID}">${item.CodigoProducto} - ${item.DescripcionEspecifica} (${item.CantidadDisponible})</option>`);                    });                    $("select#ProductoID").val('').trigger("chosen:updated");                    $("select#AlmacenDestino").find('option').remove();                    //$("select#AlmacenDestino").append('<option value=""></option>');                    JsonData.almacenesdestino.forEach(function (item) {                        console.log(item);                        $("select#AlmacenDestino").append('<option value="' + item.Id + '" title="' + item.Description + '">' + item.Name + '</option>');                    });                }            });        }        function Get_dataItem() {            $("input#quantity").val(null);            $("input#quantity").removeAttr('readonly');        }        function AddItem(sender) {            var $sender = $(sender);            var productoId = $("select#ProductoID").val();            var selectedProduct = JsonData.productos.find(f => f.ID == productoId);            var productName = selectedProduct.DescripcionEspecifica;            var itemId = selectedProduct.CodigoProducto;            var quantity = $("input#quantity").val();            var comentario = $("input#comentario").val();            var AlmacenOrigenId = $("select#AlmancenOrigen").val();            var AlmacenOrigenText = $('select#AlmancenOrigen option:selected').text()            var AlmacenDestinoId = $("select#AlmacenDestino").val();            var AlmancenDestinoText = $('select#AlmacenDestino option:selected').text()            var fl = parseFloat(quantity);            if (isNaN(fl) || fl <= 0) {                toastr.warning(`Ingrese un valor númerico mayor a 0`);                return;            }            if (selectedProduct.CantidadDisponible < fl) {                toastr.warning(`Cantidad disponible actualmente ${selectedProduct.CantidadDisponible}`);                return;            }            $('#table-items tbody')                .append(                    `<tr>                                   <td hidden='hidden' id='detId'><input rawname='ID' readonly value=0/></td>                                   <td hidden='hidden' id='detProductId'><input rawname='ProductoId' readonly value =${selectedProduct.ID} /></td>                                   <td hidden='hidden' id='detAlmacenOrigen'><input rawname='AlmacenOrigen' readonly value =${AlmacenOrigenId} /></td>                                   <td hidden='hidden' id='detAlmacenDestino'><input rawname='AlmancenDestino' readonly value =${AlmacenDestinoId} /></td>                                   <td id='detItemId'><input rawname='CodigoBarra' class="form-control  input-sm" readonly value=${itemId} /></td>                                   <td id='detProduct'><input  class="form-control  input-sm" readonly value=${productName} /></td>                                   <td id='detAlmacenOrigenNombre'><input  class="form-control  input-sm" readonly value=${AlmacenOrigenText} /></td>                                   <td id='detAlmacenDestinoNombre'><input  class="form-control  input-sm" readonly value=${AlmancenDestinoText} /></td>                                   <td id='detQuantity'><input rawname='Cantidad' class="form-control  input-sm"  style="text-align:right" readonly value=${quantity} /></td>                                   <td id='detComentario'><input rawname='Comentario' class="form-control  input-sm"  style="text-align:right" readonly value=${comentario??""} /></td>                                   <td id='detRemove'><a href='#' onclick="$(this).closest('tr').remove();FixNameDetail();"><i  style='color:red;vertical-align:middle'class="glyphicon glyphicon-remove"></i></a></td>                            </tr>`);            ClearRow();            FixNameDetail()        }        function ClearRow() {            $("input#quantity").val(null);            $('select#ProductoID').val('').trigger('chosen:updated');        }        function FixNameDetail() {            $('#table-items tbody td input[rawname]').each(function (index, item) {                item = $(item);                var index = $(item).closest('tr').index();                var rawname = item.attr('rawname');                item.attr('name', `TrasladoDetalle[${index}].${rawname}`);            });        }        $("input#quantity,input#comentario").on("keydown", function (e) {            console.log("keydown");            var keyCode = (e.keyCode ? e.keyCode : e.which);            if (keyCode == 13) {                e.preventDefault();                AddItem($("#btnAddItem")[0]);            }        });        function validationonsubmit() {            var rowcounts = $("#table-items tbody tr").length;            if (rowcounts == 0) {                toastr.warning("Registre una fila para guardar la compra");                return false;            };            return true;        }    </script>}