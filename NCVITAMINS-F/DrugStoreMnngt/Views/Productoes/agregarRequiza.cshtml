@model DrugStoreMnngt.Models.RequizaCustom@using (Html.BeginForm("agregarRequiza","Productoes",FormMethod.Post, new { onsubmit = "return validationonsubmit();" })){<div class="container">    <div class="row">        <br>        <div class="col-md-12">            <div class="form-horizontal">                @*<div class="col-md-3">                    <div class="form-group">                        @Html.LabelFor(m => m.Invoice.ID)                        @Html.TextBoxFor(m => m.Invoice.ID, new { @readonly = "readonly", @class = "form-control" })                    </div>                </div>*@                <div class="col-md-3">                    <div class="form-group">                        @Html.Label("Proveedor")                        <br />                        @Html.DropDownList("ProveedorID", Enumerable.Empty<SelectListItem>(), new { @class = "form-control  input-sm", @Name = "requiza.IDProveedor", @required = "required" })                    </div>                </div>                <div class="col-md-3">                    <div class="form-group">                        @Html.Label("Almacén")                        <br />                        @Html.DropDownList("Almancen", Enumerable.Empty<SelectListItem>(), new { @class = "form-control  input-sm", @Name = "requiza.AlmacenId", @required = "required" })                    </div>                </div>                @*<div class="col-md-3">                    <div class="form-group">                        @Html.Label("Fecha")                        <br />                        @Html.EditorFor(m => m.Invoice.CreatedOn, new { @class = "form-control datepicker", @Name = "Invoice.ClientID", @type = "date" })                        @Html.ValidationMessageFor(m => m.Invoice.CreatedOn, " ", new { @class = "req" })                    </div>                </div>*@                <table class="direction table table-bordered">                    <thead>                        @*                        <tr>                            <th>                                @Html.DisplayName("Producto")                            </th>                            <th>                                @Html.DisplayName("Cantidad")                            </th>                            <th>                                @Html.DisplayName("Action")                            </th>                        </tr>*@                    </thead>                    <tbody>                        <tr id="trToInsert">                            <td>                                <div class="col-lg-4">                                    <div class="form-group" style="margin-bottom: 0px;">                                        @Html.DropDownList("ProductoID", Enumerable.Empty<SelectListItem>(), new { @class = "form-control", @onchange = "Get_dataItem()" })                                    </div>                                </div>                            </td>                            <td>                                <div class="col-lg-8">                                    <div class="form-group" style="margin-bottom: 0px;">                                        @Html.TextBox("quantity", " ", new { @id = "quantity", @placeholder = "Digite la cantidad", @class = "form-control  input-sm", @readonly = "readonly" })                                    </div>                                </div>                            </td>                            <td>                                <button id="btnAddItem" type="button" class="btn btn-primary btn-sm" onclick="AddItem(this)">                                    <span class="glyphicon glyphicon-plus"></span> Agregar                                </button>                            </td>                        </tr>                    </tbody>                </table>                <table id="table-items" class="direction table table-bordered table-condensed">                    <thead>                        <tr>                            <th>                                @Html.DisplayName("Codigo Barra")                            </th>                            <th>                                @Html.DisplayName("Producto")                            </th>                            <th>                                @Html.DisplayName("Cantidad")                            </th>                            <th>                            </th>                    </thead>                    <tbody>                    </tbody>                </table>                <div class="col-md-3">                    <br />                    <button id="btnInsert" name="btnInsert" type="submit" class="btn btn-success btn-sm">                        <i class="glyphicon glyphicon-floppy-disk"></i> Guardar                    </button>                </div>                <br>            </div>        </div>    </div></div>}<br><div>    <a href="detallesRequiza" class="btn btn-danger btn-xs"><span class="glyphicon glyphicon-chevron-left"></span> Regresar</a></div>@section scripts{<script>        $(document).ready(function () {        showLoadingProcess(true,'Cargando');            $.ajax({                dataType: "json",                url: "GetProductosJson",                success: function (response) {                    showLoadingProcess(false);                    JsonData = response;                    $("select#ProveedorID").append('<option value=""></option>');                    JsonData.proveedor.forEach(function (item) {                        $("select#ProveedorID").append('<option value="' + item.ID + '">' + item.Nombre + '</option>');                    });                    $("select#ProductoID").append('<option value=""></option>');                    JsonData.productos.forEach(function (item) {                        $("select#ProductoID").append(`<option value="${item.ID}">${item.CodigoProducto} - ${item.DescripcionEspecifica}</option>`);                    });                    $("select#Almancen").append('<option value=""></option>');                    JsonData.almacenes.forEach(function (item) {                        $("select#Almancen").append('<option value="' + item.Id + '" title="'+ item.Description +'">' + item.Name + '</option>');                    });                    $("select#ProductoID").chosen({ allow_single_deselect: true, width: '300px' });                }            });            $("select#ProductoID").attr('data-placeholder', "Seleccione un producto");            $("select#ProductoID").removeAttr('name');        });        function Get_dataItem() {            var productoId = $("select#ProductoID").val();            var selectedProduct = JsonData.productos.find(f => f.ID == productoId);            console.log(selectedProduct);            $("input#item_Id").val(selectedProduct.CodigoBarra);            $("input#price").val(selectedProduct.PrecioVenta);            //$("input#Precio").attr('readonly', 'readonly');            $("input#quantity").val(null);            $("input#quantity").removeAttr('readonly');        }        function AddItem(sender) {            var $sender = $(sender);            var $row = $sender.closest('tr');            var productoId = $("select#ProductoID").val();            var selectedProduct = JsonData.productos.find(f => f.ID == productoId);            var productName = selectedProduct.DescripcionEspecifica;            var itemId = selectedProduct.CodigoProducto;            var price = selectedProduct.PrecioVenta;            var quantity = $row.find("input#quantity").val();            var fl = parseFloat(quantity)            if (isNaN(fl) || fl <= 0) {                toastr.warning(`Ingrese un valor númerico mayor a 0`);                return;            }            $('#table-items tbody')                .append(                    `<tr>                                        <td hidden='hidden' id='detId'><input rawname='ID' readonly value=0/></td>                                        <td hidden='hidden' id='detProductId'><input rawname='IDProducto' readonly value =${selectedProduct.ID} /></td>                                        <td id='detItemId'><input rawname='CodigoBarra' class="form-control  input-sm" readonly value=${itemId} /></td>                                        <td id='detProduct'><input  class="form-control  input-sm" readonly value=${productName} /></td>                                        <td id='detQuantity'><input rawname='Cantidad' class="form-control  input-sm"  style="text-align:right" readonly value=${quantity} /></td>                                        <td id='detRemove'><a href='#' onclick="$(this).closest('tr').remove();FixNameDetail();"><i  style='color:red;vertical-align:middle'class="glyphicon glyphicon-remove"></i></a></td>                                 </tr>`);            ClearRow();            FixNameDetail()        }        function ClearRow() {            var $row = $("#trToInsert");            $row.find('input#item_Id').val(null);            $row.find("input#price").val(null);            $row.find("input#quantity").val(null);            $('select#ProductoID').val('').trigger('chosen:updated');        }        function FixNameDetail() {            $('#table-items tbody td input[rawname]').each(function (index, item) {                item = $(item);                var index = $(item).closest('tr').index();                var rawname = item.attr('rawname');                item.attr('name', `requizaDetalle[${index}].${rawname}`);            });        }    $("input#quantity").on("keydown", function (e) {        console.log("keydown");        var keyCode = (e.keyCode ? e.keyCode : e.which);        if (keyCode == 13) {            e.preventDefault();            AddItem($("#btnAddItem")[0]);        }    });    function validationonsubmit() {        var rowcounts = $("#table-items tbody tr").length;        if (rowcounts == 0) {            toastr.warning("Registre una fila para guardar la compra");            return false;        };        return true;    }</script>}