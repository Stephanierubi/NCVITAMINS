@model IEnumerable<DrugStoreMnngt.Models.DeatellesRequizaCustom>
@using SecurityShell.Models;
@{
    ViewBag.Title = "Compras";
}

<h2>@*Lista de compras de productos*@</h2>
@{
    if (InformationIdentity.TypeID() == 1)
    {
        <p>
            @if (!ViewBag.ConciliacionAbierta)
            {
                <a href="@Url.Action("agregarRequiza","Productoes")" class="btn btn-primary btn-xs"><span class="glyphicon glyphicon-plus"></span> Nueva compra de productos</a>
            }
            else
            {
              <a class="btn btn-primary btn-xs" onclick="toastr.warning('Conciliación pendiente de procesar');"><span class="glyphicon glyphicon-plus"></span> Nueva compra de productos</a>
            }
        </p>
    }
}
<table id="tablelist" class=" table-striped display compact dt-body-center dt-head-center">
    <thead>
        <tr>
            <th>
                Proveedor
            </th>
            <th>
                Fecha
            </th>
            <th>
                Almacén
            </th>
            <th>
                Cantida Productos
            </th>


            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.nombreProveedor)
                </td>
                <td>
                    @{string fec = string.Empty;
                        if (item.fecha.HasValue)
                        {
                            fec = item.fecha.Value.ToString("dd/MM/yy");
                        }
                    }
                    @Html.DisplayFor(modelItem => fec)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.cantidadProducto)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.nombreAlmacen)
                </td>
                <td>

                    @Html.ActionLink("Detalle", "itemRequiza", new { id = item.ID })



                </td>
            </tr>
        }
    </tbody>
</table>
@section scripts
    {
    <script>

        $(document).ready(function () {

            var table = $('#tablelist').DataTable({
                lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
                fixedHeader: false,
                dom: 'Blfrtip',
                buttons: [
                     'excel'

                ]

            });
            console.log("Info usuario id " + @InformationIdentity.TypeID());
            function getButtonsString() {
                var info;
                if (@InformationIdentity.TypeID() !== 2) {
                    info = "'copy', 'excel', 'pdf'";
                }
                return info;
            }



        });

    </script>

}