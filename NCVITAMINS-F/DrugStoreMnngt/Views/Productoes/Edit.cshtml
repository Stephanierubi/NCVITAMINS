@model DrugStoreMnngt.Models.BD.Producto

@{
    ViewBag.Title = "Edit";
}

<h2>@*Editar Producto*@</h2>

@using (Html.BeginForm())
{


    <div class="form-horizontal">
        <h4>Editar producto</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.ID)
        @Html.HiddenFor(model => model.Activo)
        @Html.HiddenFor(model => model.CreatedBy)
        @Html.HiddenFor(model => model.CreatedOn)

        <div class="form-group">
            @Html.Label("Código de producto", htmlAttributes: new { @class = "control-label col-md-2 input-sm" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.CodigoProducto, new { htmlAttributes = new { @class = "form-control  input-sm" } })
                @Html.ValidationMessageFor(model => model.CodigoProducto, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.Label("Nombre", htmlAttributes: new { @class = "control-label col-md-2 input-sm" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.DescripcionEspecifica, new { htmlAttributes = new { @class = "form-control  input-sm" } })
                @Html.ValidationMessageFor(model => model.DescripcionEspecifica, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Descripción general", htmlAttributes: new { @class = "control-label col-md-2 input-sm" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.DescripcionGeneral, new { htmlAttributes = new { @class = "form-control  input-sm" } })
                @Html.ValidationMessageFor(model => model.DescripcionGeneral, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelForModel("Marca", htmlAttributes: new { @class = "control-label col-md-2 input-sm" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Marca, new { htmlAttributes = new { @class = "form-control  input-sm" } })
                @Html.ValidationMessageFor(model => model.Marca, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Fecha de vencimiento", htmlAttributes: new { @class = "control-label col-md-2 input-sm " })
            <div class="col-md-10">
                @Html.TextBoxFor(model => model.FechaVencimiento, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control datepicker  input-sm" })
                @Html.ValidationMessageFor(model => model.FechaVencimiento, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelForModel("Tipo Presentación", htmlAttributes: new { @class = "control-label col-md-2 input-sm" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.TipoPrecentacionID, @ViewBag.TipoPrecentacion as SelectList, new { @class = "form-control  input-sm" })
                @Html.ValidationMessageFor(model => model.TipoPrecentacionID, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Precio de compra", htmlAttributes: new { @class = "control-label col-md-2 input-sm" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.PrecioCompra, new { htmlAttributes = new { @class = "form-control  input-sm" } })
                @Html.ValidationMessageFor(model => model.PrecioCompra, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Precio de venta", htmlAttributes: new { @class = "control-label col-md-2 input-sm" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.PrecioVenta, new { htmlAttributes = new { @class = "form-control  input-sm" } })
                @Html.ValidationMessageFor(model => model.PrecioVenta, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelForModel("Proveedor", htmlAttributes: new { @class = "control-label col-md-2 input-sm" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.ProveedorID, @ViewBag.Prove as SelectList, new { @class = "form-control  input-sm" })
                @Html.ValidationMessageFor(model => model.ProveedorID, "", new { @class = "text-danger" })
            </div>
        </div>



        <div class="form-group">
            @Html.Label("Cantidad disponible", htmlAttributes: new { @class = "control-label col-md-2 input-sm" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.CantidadDisponible, new { htmlAttributes = new { @class = "form-control  input-sm", @readonly = "readonly" } })
                @Html.ValidationMessageFor(model => model.CantidadDisponible, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Cantidad presentación", htmlAttributes: new { @class = "control-label col-md-2 input-sm " })
            <div class="col-md-10">
                @Html.EditorFor(model => model.CantidadPrecentacion, new { htmlAttributes = new { @class = "form-control input-sm" } })
                @Html.ValidationMessageFor(model => model.CantidadPrecentacion, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelForModel("Tipo Venta", htmlAttributes: new { @class = "control-label col-md-2 input-sm" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.TipoVentaID, @ViewBag.TipoVenta as SelectList, new { @class = "form-control  input-sm" })
                @Html.ValidationMessageFor(model => model.TipoVentaID, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelForModel("Almacen", htmlAttributes: new { @class = "control-label col-md-2 input-sm" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.Almacen, @ViewBag.Almacen as SelectList, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Almacen, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelForModel("Laboratorio", htmlAttributes: new { @class = "control-label col-md-2 input-sm" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.Laboratorio, @ViewBag.Laborario as SelectList, new { @class = "form-control  input-sm" })
                @Html.ValidationMessageFor(model => model.Laboratorio, "", new { @class = "text-danger" })
            </div>
        </div>



        <div class="form-group">
            @Html.Label("Stock mínimo", htmlAttributes: new { @class = "control-label col-md-2 input-sm" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.StockMinimo, new { htmlAttributes = new { @class = "form-control  input-sm" } })
                @Html.ValidationMessageFor(model => model.StockMinimo, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Código de barras", htmlAttributes: new { @class = "control-label col-md-2 input-sm" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.CodigoBarra, new { htmlAttributes = new { @class = "form-control input-sm" } })
                @Html.ValidationMessageFor(model => model.CodigoBarra, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Save" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div>

    <a href="../Index" class="btn btn-danger btn-xs"><span class="glyphicon glyphicon-chevron-left"></span> Regresar</a>
</div>
