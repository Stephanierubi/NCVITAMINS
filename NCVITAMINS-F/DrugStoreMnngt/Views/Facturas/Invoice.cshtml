@model DrugStoreMnngt.Models.Collection_invoice@using (Html.BeginForm("Invoice", "Facturas", FormMethod.Post, new { onsubmit = "return validationonsubmit();" })){<div class="container">    <div class="row">        <br>        <div class="col-md-12">            <div class="form-horizontal">                @*<div class="col-md-3">                        <div class="form-group">                            @Html.LabelFor(m => m.Invoice.ID)                            @Html.TextBoxFor(m => m.Invoice.ID, new { @readonly = "readonly", @class = "form-control" })                        </div>                    </div>*@                <div class="col-md-3">                    <div class="form-group">                        @Html.Label("Cliente", new { @class = "form-label input-sm" })                        <button type="button" class="btn btn-sm btn-success" data-toggle="modal" data-target="#exampleModal">                          Agregar +                        </button>                        <br />                        @Html.DropDownList("ClienteID", @ViewBag.Clientes as SelectList, new { @class = "form-control input-sm", @Name = "Invoice.ClientID", @onchange = "SetTienda();", @required = "required" })                    </div>                </div>                <div class="col-md-3">                    <div class="form-group">                        @Html.Label("Tienda", new { @class = "form-label input-sm" })                        <br />                        @Html.DropDownList("Tienda", @ViewBag.Tiendas as SelectList, new { @class = "form-control input-sm", Style = "color:cornflowerblue;font-weight:bold !important;", @Name = "Invoice.Tienda", @required = "required", @onchange = "GetProductoByStorageDefault();" })                    </div>                </div>                <div class="col-md-3">                    <div class="form-group">                        @Html.Label("Forma de pago", new { @class = "form-label input-sm" })                        <br />                        @Html.DropDownList("FormaPago", @ViewBag.FormaPago as SelectList, new { @class = "form-control input-sm", Style = "color:cornflowerblue;font-weight:bold !important;", @Name = "Invoice.FormaPago", @required = "required", @onchange = "SetLabelFormaPago();" })                    </div>                </div>                @*<div class="col-md-3">                        <div class="form-group">                            @Html.Label("Fecha")                            <br />                            @Html.EditorFor(m => m.Invoice.CreatedOn, new { @class = "form-control datepicker", @Name = "Invoice.ClientID", @type = "date" })                            @Html.ValidationMessageFor(m => m.Invoice.CreatedOn, " ", new { @class = "req" })                        </div>                    </div>*@                <table class="direction table table-bordered">                    <!--<thead>                    <tr>                        <th>                            @Html.DisplayName("Código")                        </th>                        <th>                            @Html.DisplayName("Producto")                        </th>                        <th>                            @Html.DisplayName("Precio")                        </th>                        <th>                            @Html.DisplayName("Cantidad")                        </th>                        <th>-->                    @*@Html.DisplayName("Action")*@                    <!--</th>                        </tr>                    </thead>-->                    <tbody>                        <tr id="trToInsert">                            <td>                                <div class="col-lg-8">                                    <div class="form-group" style="margin-bottom: 0px;">                                        @Html.TextBoxFor(m => m.Invoice.CodigoBarra, new { @readonly = "readonly", @id = "item_Id", @class = "form-control input-sm" })                                    </div>                                </div>                            </td>                            <td>                                <div class="col-lg-4">                                    <div class="form-group" style="margin-bottom: 0px;">                                        @Html.DropDownList("ProductoID", Enumerable.Empty<SelectListItem>(), new { @class = "form-control", @placeholder = "Seleccione un producto", @onchange = "Get_dataItem()" })                                    </div>                                </div>                            </td>                            <td>                                <div class="col-lg-8">                                    <div class="form-group" style="margin-bottom: 0px;">                                        @Html.TextBoxFor(m => m.Invoice.Valor, new { @id = "price", @readonly = "readonly", @class = "form-control input-sm" })                                    </div>                                </div>                            </td>                            <td>                                <div class="col-lg-8">                                    <div class="form-group" style="margin-bottom: 0px;">                                        @Html.TextBox("quantity", " ", new { @id = "quantity", @value = "", @class = "form-control input-sm", @placeholder = "Digite la cantidad", @readonly = "readonly" })                                    </div>                                </div>                            </td>                            <td>                                <button id="btnAddItem" type="button" class="btn btn-primary btn-sm" onclick="AddItem(this)">                                    <span class="glyphicon glyphicon-plus"></span> Agregar                                </button>                            </td>                        </tr>                    </tbody>                </table>                <table id="table-items" class="direction table table-bordered table-condensed">                    <thead>                        <tr>                            <th>                                @Html.DisplayName("Código")                            </th>                            <th>                                @Html.DisplayName("Producto")                            </th>                            <th>                                @Html.DisplayName("Precio")                            </th>                            <th>                                @Html.DisplayName("Cantidad")                            </th>                            <th>                                @Html.DisplayName("Total")                            </th>                            <th>                            </th>                    </thead>                    <tbody>                    </tbody>                </table>                <div class="col-md-3">                    <div class="form-group form-inline">                        @Html.Label("Total", new { @class = "form-label input-sm" })                        @Html.TextBoxFor(m => m.Invoice.total, new { @readonly = "readonly", @style = "text-align:right;width: 80%", @class = "form-control input-sm" })                    </div>                </div>                <div class="col-md-3">                    <a href="#" data-toggle="modal" data-target="#smallModal" class="btn btn-success btn-sm col-lg-4">                        <i class="glyphicon glyphicon-list-alt"></i> Facturar                    </a>                </div>            </div>        </div>        <a href="@Url.Action("Index","Facturas")" class="btn btn-danger btn-xs"><span class="glyphicon glyphicon-chevron-left"></span> Regresar</a>    </div></div><div class="modal fade" id="smallModal" tabindex="-1" role="dialog" aria-labelledby="smallModal" aria-hidden="true">    <div class="modal-dialog modal-sm" style="vertical-align:middle">        <div class="modal-content">            @*<div class="modal-header">                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>                    <h4 class="modal-title" id="myModalLabel">Small Modal</h4>                </div>*@            <div class="modal-body">                <h5 id="labelFormaPago">¿Desea facturar?</h5>            </div>            <div class="modal-footer">                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>                <button class="btn btn-success" id="btnInsert" type="submit"> <i class="glyphicon glyphicon-list-alt"></i> Facturar</button>            </div>        </div>    </div></div>}<!-- Modal --><div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">    <div class="modal-dialog" role="document">        @using (Html.BeginForm("agregarCliente","Clientes"))        {            <div class="modal-content">                <div class="modal-header">                    <h5 class="modal-title" id="exampleModalLabel">Agregar Cliente</h5>                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">                        <span aria-hidden="true">&times;</span>                    </button>                </div>                <div class="modal-body">                    <div class="form-group">                        @Html.LabelForModel("Telefono", htmlAttributes: new { @class = "control-label  input-sm" })                        <div class="">                            @Html.EditorFor(model => model.telefono, "{0:###-###-####}", new { htmlAttributes = new { @class = "form-control input-sm" } })                            @Html.ValidationMessageFor(model => model.telefono, "", new { @class = "text-danger" })                        </div>                    </div>                    <div class="form-group">                        @Html.LabelForModel("Nombre", htmlAttributes: new { @class = "control-label  input-sm" })                        <div class="">                            @Html.EditorFor(model => model.nombreCliente, new { htmlAttributes = new { @class = "form-control input-sm" } })                            @Html.ValidationMessageFor(model => model.nombreCliente, "", new { @class = "text-danger" })                        </div>                    </div>                    <div class="form-group">                        @Html.LabelForModel("Apellido", htmlAttributes: new { @class = "control-label  input-sm" })                        <div class="">                            @Html.EditorFor(model => model.apellidoCliente, new { htmlAttributes = new { @class = "form-control input-sm" } })                            @Html.ValidationMessageFor(model => model.apellidoCliente, "", new { @class = "text-danger" })                        </div>                    </div>                    <div class="form-group">                        @Html.LabelForModel("Fecha Nacimiento", htmlAttributes: new { @class = "control-label  input-sm" })                        <div class="">                            @Html.TextBoxFor(model => model.fechaNacimiento, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control datepicker col-md-8", @required = "required" })                            @Html.ValidationMessageFor(model => model.fechaNacimiento, "", new { @class = "text-danger" })                        </div>                    </div>                </div>                <div class="modal-footer">                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>                    <button class="btn btn-primary" type="submit">Guardar</button>                </div>            </div>        }        </div></div>@section scripts{    <script>        $(document).ready(function () {           /* $.ajax({                dataType: "json",                url: "GetDataJson",                success: function (response) {                    JsonData = response;                    $("select#ClienteID").append('<option value=""></option>');                    JsonData.responsables.forEach(function (item) {                        $("select#ClienteID").append('<option value="' + item.ID + '">' + item.Telefono + ' - ' + item.Nombres + ' ' + item.Apellidos + '</option>');                    });                    if (localStorage.LSTienda == undefined) {                        $("select#Tienda").append('<option value=""></option>');                    }                    JsonData.tiendas.filter(f => localStorage.LSTienda != undefined ? f.Id == localStorage.LSTienda : true).forEach(function (item) {                        $("select#Tienda").append('<option value="' + item.Id + '">' + item.Name + '</option>');                    });                    $("select#FormaPago").append('<option value=""></option>');                    JsonData.formaPago.forEach(function (item) {                        $("select#FormaPago").append('<option value="' + item.Id + '">' + item.Name + '</option>');                    });                }            });*/            $("#ClienteID").chosen();            $('select#ClienteID').trigger('chosen:updated');            $("select#ProductoID").removeAttr('name');                     $("#telefono").mask('000-000-0000');        });        function GetProductoByStorageDefault() {            $.ajax({                dataType: "json",                url: "GetProductosJson?TiendaId=" + $("select#Tienda").val(),                success: function (response) {                    JsonData = response;                    $("select#ProductoID option").remove();                    $("select#ProductoID").append('<option value=""></option>');                    JsonData.productos.forEach(function (item) {                        $("select#ProductoID").append(`<option ${(item.CantidadDisponible ?? 0) == 0 ? "disabled='true' title='No hay existencias'" : ""} value="${item.ID}">${item.CodigoProducto} - ${item.DescripcionEspecifica} - ${item.CodigoBarra} (${item.CantidadDisponible ?? 0})</option>`);                    });                    $("select#ProductoID").attr('data-placeholder', "Seleccione un producto");                    $("select#ProductoID").chosen({ allow_single_deselect: true, width: '300px' });                    $('select#ProductoID').trigger('chosen:updated');                }            });        }        function Get_dataItem() {            var productoId = $("select#ProductoID").val();            var selectedProduct = JsonData.productos.find(f => f.ID == productoId);            console.log(selectedProduct);            $("input#item_Id").val(selectedProduct.CodigoProducto);            $("input#price").val(selectedProduct.PrecioVenta);            //$("input#Precio").attr('readonly', 'readonly');            $("input#quantity").removeAttr('readonly');            $("input#quantity").val(null);        }        function AddItem(sender) {            var $sender = $(sender);            var $row = $sender.closest('tr');            var productoId = $("select#ProductoID").val();            var selectedProduct = JsonData.productos.find(f => f.ID == productoId);            var productName = selectedProduct.DescripcionEspecifica;            var itemId = selectedProduct.CodigoProducto;            var itemCodBarra = selectedProduct.CodigoBarra;            var price = selectedProduct.PrecioVenta;            var quantity = $row.find("input#quantity").val();            if (selectedProduct.CantidadDisponible < quantity) {                toastr.warning(`Cantidad disponible actualmente ${selectedProduct.CantidadDisponible}`);                return;            }            var fl = parseFloat(quantity)            if (isNaN(fl) || fl <= 0) {                toastr.warning(`Ingrese un valor númerico mayor a 0`);                return;            }            var total = price * quantity;            $('#table-items tbody')                .append(                    `<tr>                                                                                <td hidden='hidden' id='detId'><input rawname='ID' readonly value=0/></td>                                                                                <td hidden='hidden' id='detProductId'><input rawname='ProductoID' readonly value =${selectedProduct.ID} /></td>                                                                                <td id='detItemId'><input rawname='CodigoBarra' title="${itemCodBarra}" class="form-control input-sm" readonly value=${itemId} /></td>                                                                                <td id='detProduct'><input  class="form-control input-sm" readonly value=${productName} /></td>                                                                                <td id='detPrice'><input rawname='Valor' class="form-control input-sm"  style="text-align:right" readonly value=${price} /></td>                                                                                <td id='detQuantity'><input rawname='Cantidad' class="form-control input-sm"  style="text-align:right" readonly value=${quantity} /></td>                                                                                <td id='detTotal'><input class="form-control input-sm" style="text-align:right" readonly value=${total} /></td>                                                                                <td id='detRemove'><a href='#' onclick="$(this).closest('tr').remove();CalculateTotal();FixNameDetail();"><i  style='color:red;vertical-align:middle'class="glyphicon glyphicon-remove"></i></a></td>                                                                         </tr>`);            ClearRow();            CalculateTotal();            FixNameDetail()            event.stopPropagation();        }        function ClearRow() {            var $row = $("#trToInsert");            $row.find('input#item_Id').val(null);            $row.find("input#price").val(null);            $row.find("input#quantity").val(null);            $('select#ProductoID').val('').trigger('chosen:updated');        }        function CalculateTotal() {            var total = 0.00;            $('td#detTotal input').each(function (index, item) {                var value = parseFloat($(item).val());                total += isNaN(value) ? 0 : value;            });            $('#Invoice_total').val(total);        }        function FixNameDetail() {            $('#table-items tbody td input[rawname]').each(function (index, item) {                item = $(item);                var index = $(item).closest('tr').index();                var rawname = item.attr('rawname');                item.attr('name', `InvoiceDetail[${index}].${rawname}`);            });        }        $("input#quantity").on("keydown", function (e) {            console.log("keydown");            var keyCode = (e.keyCode ? e.keyCode : e.which);            if (keyCode == 13) {                e.preventDefault();                AddItem($("#btnAddItem")[0]);            }        });        function SetLabelFormaPago() {            var txtFormaPago = $("select#FormaPago").find('option:selected').text();            $("#labelFormaPago").text(`¿Desea factura ${txtFormaPago}?`);        }        function SetTienda() {            var responsable = $("select#ClienteID").val();            var responsableFound = JsonData.responsables.find(f => f.ID == responsable);            var tienda = $("select#Tienda").val();            if (tienda == null || tienda == '') {                $("select#Tienda").val(responsableFound.Tienda);            }            GetProductoByStorageDefault();        }        function validationonsubmit() {            $("#btnInsert").attr("disabled", true);            var rowcounts = $("#table-items tbody tr").length;            if (rowcounts == 0) {                toastr.warning("Registre una fila para facturar");                return false;            };            return true;        }    </script>    <style>        .form-control-xs {            height: calc(1em + .375rem + 2px) !important;            padding: .125rem .25rem !important;            font-size: .75rem !important;            line-height: 1.5;            border-radius: .2rem;        }    </style>}