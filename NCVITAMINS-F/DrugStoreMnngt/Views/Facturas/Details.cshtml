@model IEnumerable<DrugStoreMnngt.Models.FacturaDetalleCustom>

@{
    ViewBag.Title = "Detalle Factura";
}

<h4>Detalle Facturas</h4>

<table id="tbldet" class=" table-striped display compact dt-body-center dt-head-center">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Cantidad</th>
            <th> Valor</th>
            <th>Neto</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ProductoNombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cantidad)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Valor)
                </td>
                <td>
                    @{var neto = (item.Cantidad * item.Valor); }
                    @Html.DisplayFor(modelItem => neto)
                </td>
                <td>
                    @{
                        var color = "";
                        var status = "";
                        if (item.Devolucion == null)
                        {
                            color = "#f0ad4e";
                            status = "Pendiente";
                        }
                        else if (item.Devolucion.Value)
                        {
                            color = "#ac2925";
                            status = "Devuelto";
                        }
                        else
                        {
                            color = "#204d74";
                            status = "Confirmado";
                        }
                    }
                    <label class="badge" style="background-color:@color">@status</label>
                </td>
            </tr>
        }
    </tbody>
</table>
<p>
    @Html.ActionLink("Regresar", "Index")
</p>

@section scripts
    {

    <script>
        $(document).ready(function () {

            var table = $('#tbldet').DataTable({
                lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
                fixedHeader: false,
                dom: 'Blfrtip',
                buttons: [
                    'excel'

                ]

            });
        });

    </script>
}